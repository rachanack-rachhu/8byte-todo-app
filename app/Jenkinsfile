stage('Deploy to Staging') {
    steps {
        sh '''
            echo "Deploying to Staging on EKS..."

            # Update kubeconfig
            aws eks update-kubeconfig --region ap-south-1 --name 8byte-devops-stg

            # Replace image tag in deployment
            sed "s|TAG|${BUILD_NUMBER}|g" app/k8s/deployment.yaml > /tmp/deployment-staging.yaml

            # Apply manifests
            kubectl apply -f /tmp/deployment-staging.yaml
            kubectl apply -f app/k8s/service.yaml

            # Wait for rollout
            kubectl rollout status deployment/todo-app
            kubectl get svc todo-app-service
        '''
    }
}

stage('Manual Approval for Production') {
    steps {
        input message: 'Deploy to Production?', ok: 'Yes, Deploy'
    }
}

stage('Deploy to Production') {
    steps {
        sh '''
            echo "Deploying to Production on EKS..."

            # For now using same cluster with different namespace (or change cluster name)
            kubectl create namespace production --dry-run=client -o yaml | kubectl apply -f -

            sed "s|TAG|${BUILD_NUMBER}|g" app/k8s/deployment.yaml > /tmp/deployment-prod.yaml

            kubectl apply -f /tmp/deployment-prod.yaml -n production
            kubectl apply -f app/k8s/service.yaml -n production

            kubectl rollout status deployment/todo-app -n production
            kubectl get svc -n production
        '''
    }
}
